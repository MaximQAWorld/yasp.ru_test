                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /booking?firstname=Jim&lastname=Brown (positive filter)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking?firstname=Jim&lastname=Brown"
          },
          "event": [
            {
              "listen": "test",
              "script": {
