                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /booking?checkin&checkout (negative - filter bug BUG-03)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking?checkin=2026-01-01&checkout=2026-01-15"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "// Известный баг: фильтрация по датам может возвращать записи вне диапазона, см. BUG-03"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /booking/{{bookingId}} - existing id (positive)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has firstname field', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('firstname');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /booking/999999999 - non-existent id (negative)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/999999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking - Update",
