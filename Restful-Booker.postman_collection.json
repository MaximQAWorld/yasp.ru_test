          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Basic YWRtaW46cGFzc3dvcmQxMjM="
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"James\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-15\"\n  },\n  \"additionalneeds\": \"Lunch\"\n}"
            },
            "url": "{{baseUrl}}/booking/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
