{
  "info": {
    "name": "Restful Booker API - Test Assignment",
    "description": "Позитивные и негативные тесты для https://restful-booker.herokuapp.com (auth, booking CRUD, ping). PUT/PATCH/DELETE с авторизацией используют Basic Auth (admin:password123) вместо Cookie — см. README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ping",
      "item": [
        {
          "name": "GET /ping - health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 (known quirk, see BUG-02)', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth - valid credentials (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has non-empty token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.to.have.length.above(0);",
                  "    pm.collectionVariables.set('token', json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth - wrong password (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpass\"\n}"
            },
            "url": "{{baseUrl}}/auth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response does not contain token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.undefined;",
                  "});",
                  "pm.test('Response contains Bad credentials reason (see BUG-05: status is 200, not 401)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.reason).to.eql('Bad credentials');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth - empty body (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/auth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No token issued for empty credentials', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking - Create",
      "item": [
        {
          "name": "POST /booking - full valid body (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": "{{baseUrl}}/booking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has bookingid and matching booking object', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.bookingid).to.be.a('number');",
                  "    pm.expect(json.booking.firstname).to.eql('Jim');",
                  "    pm.expect(json.booking.totalprice).to.eql(111);",
                  "    pm.collectionVariables.set('bookingId', json.bookingid);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /booking - missing firstname (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-15\"\n  }\n}"
            },
            "url": "{{baseUrl}}/booking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server should reject missing required field with 400 (see BUG-04 if this fails)', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /booking - totalprice as string (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": \"111\",\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-15\"\n  }\n}"
            },
            "url": "{{baseUrl}}/booking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server should reject wrong data type with 400 (see BUG-04 if this fails)', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /booking - negative totalprice (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": -500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-15\"\n  }\n}"
            },
            "url": "{{baseUrl}}/booking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server should reject negative price with 400 (see BUG-04 if this fails)', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking - Read",
      "item": [
        {
          "name": "GET /booking - list all (positive)",
          "request": {
            "method": "GET",
